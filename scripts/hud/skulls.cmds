edittag multiplayer\in_game_survival_messages.multilingual_unicode_string_list
setstring english survival_welcome "Current Objective: Survive"
setstring english survival_skull_black_eye "\uE084   Melee to recharge your Shields."
setstring english survival_skull_famine "\uE084   Enemies drop low-ammo weapons."
setstring english survival_skull_catch "\uE084   Enemies love to throw grenades."
setstring english survival_skull_iron "\uE084   Respawning is disabled. Be Careful!"
setstring english survival_skull_mythic "\uE084   Enemies have 2x health."
setstring english survival_skull_thunderstorm "\uE084   Enemies are upgraded."
setstring english survival_skull_tilt "\uE084   Enemy shields deflect bullets."
setstring english survival_skull_tough_luck "\uE084   Enemies always evade danger."
SaveTagChanges
Exit
